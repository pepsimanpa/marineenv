<Window x:Class="MarineEnvironment.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MarineEnvironment Viewer"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="650"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Config" FontWeight="SemiBold" />
                <TextBox x:Name="ConfigPathTextBox" Grid.Column="1" MinWidth="400" VerticalContentAlignment="Center" />
                <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,6" Click="BrowseConfig_Click">Browse...</Button>
                <Button Grid.Column="3" Margin="8,0,0,0" Padding="14,6" Click="LoadConfig_Click">Load Config</Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="310" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Data Sources" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <ListBox x:Name="SourceListBox" Height="180" DisplayMemberPath="Id" SelectionChanged="SourceListBox_SelectionChanged" />
                        <TextBlock x:Name="SelectedSourceStatusText" Margin="0,6,0,14" TextWrapping="Wrap" Foreground="#57606A" />

                        <Separator Margin="0,0,0,12" />
                        <TextBlock Text="View Bounds" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Min Lat" />
                            <TextBox x:Name="MinLatTextBox" Grid.Row="0" Grid.Column="1" Margin="0,3" Text="32" />

                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Max Lat" />
                            <TextBox x:Name="MaxLatTextBox" Grid.Row="1" Grid.Column="1" Margin="0,3" Text="43" />

                            <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Min Lon" />
                            <TextBox x:Name="MinLonTextBox" Grid.Row="2" Grid.Column="1" Margin="0,3" Text="122" />

                            <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Max Lon" />
                            <TextBox x:Name="MaxLonTextBox" Grid.Row="3" Grid.Column="1" Margin="0,3" Text="133" />

                            <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Depth (m)" />
                            <TextBox x:Name="DepthTextBox" Grid.Row="4" Grid.Column="1" Margin="0,3" ToolTip="Leave blank for sources without a depth axis or to use the first depth level." />

                            <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="Month" />
                            <ComboBox x:Name="MonthComboBox" Grid.Row="5" Grid.Column="1" Margin="0,3" SelectedIndex="7">
                                <ComboBoxItem Content="01" />
                                <ComboBoxItem Content="02" />
                                <ComboBoxItem Content="03" />
                                <ComboBoxItem Content="04" />
                                <ComboBoxItem Content="05" />
                                <ComboBoxItem Content="06" />
                                <ComboBoxItem Content="07" />
                                <ComboBoxItem Content="08" />
                                <ComboBoxItem Content="09" />
                                <ComboBoxItem Content="10" />
                                <ComboBoxItem Content="11" />
                                <ComboBoxItem Content="12" />
                            </ComboBox>
                        </Grid>

                        <TextBlock Text="Viewer Sampling" FontWeight="SemiBold" Margin="0,14,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="85" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Width" />
                            <TextBox x:Name="GridWidthTextBox" Grid.Row="0" Grid.Column="1" Margin="0,3" Text="320" />
                            <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Height" />
                            <TextBox x:Name="GridHeightTextBox" Grid.Row="1" Grid.Column="1" Margin="0,3" Text="220" />
                        </Grid>

                        <Button x:Name="RenderButton" Margin="0,14,0,0" Padding="12,8" Click="Render_Click" FontWeight="SemiBold">Render Selected Source</Button>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />

            <Border Grid.Column="2" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <TextBlock x:Name="MapTitleText" Text="No source rendered" FontSize="16" FontWeight="SemiBold" DockPanel.Dock="Left" />
                        <TextBlock x:Name="RangeText" Foreground="#57606A" HorizontalAlignment="Right" />
                    </DockPanel>

                    <Border Grid.Row="1" Background="#F6F8FA" BorderBrush="#D8DEE4" BorderThickness="1" ClipToBounds="True">
                        <Grid>
                            <Image x:Name="MapImage" Stretch="Fill" SnapsToDevicePixels="True" MouseMove="MapImage_MouseMove" MouseLeftButtonDown="MapImage_MouseLeftButtonDown" />
                            <TextBlock x:Name="EmptyMapText" Text="Load a configuration and render a READY source." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6E7781" FontSize="15" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="CursorInfoText" Grid.Column="0" Text="Lat: -   Lon: -   Value: -" />
                        <TextBlock x:Name="PointQueryText" Grid.Column="1" Margin="18,0,0,0" Foreground="#57606A" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <StatusBar Grid.Row="2" Margin="0,10,0,0">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Ready" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
