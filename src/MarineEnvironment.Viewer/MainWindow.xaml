<Window x:Class="MarineEnvironment.Viewer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MarineEnvironment Viewer"
        Width="1280" Height="900" MinWidth="1000" MinHeight="700"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="Config" FontWeight="SemiBold" />
                <TextBox x:Name="ConfigPathTextBox" Grid.Column="1" MinWidth="400" VerticalContentAlignment="Center" />
                <Button Grid.Column="2" Margin="8,0,0,0" Padding="14,6" Click="BrowseConfig_Click">Browse...</Button>
                <Button Grid.Column="3" Margin="8,0,0,0" Padding="14,6" Click="LoadConfig_Click">Load Config</Button>
            </Grid>
        </Border>
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel>
                    <TextBlock Text="Render Source" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <ListBox x:Name="SourceListBox" Height="180" DisplayMemberPath="Id" SelectionChanged="SourceListBox_SelectionChanged" />
                    <TextBlock x:Name="SelectedSourceStatusText" Margin="0,6,0,14" TextWrapping="Wrap" Foreground="#57606A" />
                    <TextBlock Text="The selected source is used only for the raster. Map clicks query all READY sources." TextWrapping="Wrap" Foreground="#57606A" FontSize="11" Margin="0,0,0,12"/>
                    <Separator Margin="0,0,0,12" />
                    <TextBlock Text="View / Point Query" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Min Lat"/><TextBox x:Name="MinLatTextBox" Grid.Row="0" Grid.Column="1" Margin="0,3" Text="32"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Max Lat"/><TextBox x:Name="MaxLatTextBox" Grid.Row="1" Grid.Column="1" Margin="0,3" Text="43"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="Min Lon"/><TextBox x:Name="MinLonTextBox" Grid.Row="2" Grid.Column="1" Margin="0,3" Text="122"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Text="Max Lon"/><TextBox x:Name="MaxLonTextBox" Grid.Row="3" Grid.Column="1" Margin="0,3" Text="133"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" VerticalAlignment="Center" Text="Depth (m)"/><TextBox x:Name="DepthTextBox" Grid.Row="4" Grid.Column="1" Margin="0,3" ToolTip="Point-query depth and render depth. Blank means no requested depth."/>
                        <TextBlock Grid.Row="5" Grid.Column="0" VerticalAlignment="Center" Text="Month"/>
                        <ComboBox x:Name="MonthComboBox" Grid.Row="5" Grid.Column="1" Margin="0,3" SelectedIndex="7">
                            <ComboBoxItem Content="01"/><ComboBoxItem Content="02"/><ComboBoxItem Content="03"/><ComboBoxItem Content="04"/><ComboBoxItem Content="05"/><ComboBoxItem Content="06"/><ComboBoxItem Content="07"/><ComboBoxItem Content="08"/><ComboBoxItem Content="09"/><ComboBoxItem Content="10"/><ComboBoxItem Content="11"/><ComboBoxItem Content="12"/>
                        </ComboBox>
                    </Grid>
                    <TextBlock Text="Viewer Sampling" FontWeight="SemiBold" Margin="0,14,0,6"/>
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="85"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Width"/><TextBox x:Name="GridWidthTextBox" Grid.Row="0" Grid.Column="1" Margin="0,3" Text="320"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Height"/><TextBox x:Name="GridHeightTextBox" Grid.Row="1" Grid.Column="1" Margin="0,3" Text="220"/>
                    </Grid>
                    <Button x:Name="RenderButton" Margin="0,14,0,0" Padding="12,8" Click="Render_Click" FontWeight="SemiBold">Render Selected Source</Button>
                </StackPanel></ScrollViewer>
            </Border>
            <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" />
            <Border Grid.Column="2" BorderBrush="#D0D7DE" BorderThickness="1" CornerRadius="6" Padding="10">
                <Grid>
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="3*"/><RowDefinition Height="Auto"/><RowDefinition Height="2*"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0"><TextBlock x:Name="MapTitleText" Text="No source rendered" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="RangeText" Foreground="#57606A" Margin="0,2,0,0"/></StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Width="32" Height="28" Margin="4,0" Click="ZoomOut_Click">−</Button><TextBlock x:Name="ZoomText" Width="58" Text="100%" VerticalAlignment="Center" TextAlignment="Center" FontWeight="SemiBold"/><Button Width="32" Height="28" Margin="4,0" Click="ZoomIn_Click">+</Button><Button Height="28" Margin="4,0,0,0" Padding="10,0" Click="ResetZoom_Click">Reset</Button></StackPanel>
                    </Grid>
                    <Border Grid.Row="1" Background="#F6F8FA" BorderBrush="#D8DEE4" BorderThickness="1" ClipToBounds="True">
                        <Grid x:Name="MapViewport" Background="Transparent" ClipToBounds="True" MouseWheel="MapViewport_MouseWheel" MouseLeftButtonDown="MapViewport_MouseLeftButtonDown" MouseLeftButtonUp="MapViewport_MouseLeftButtonUp" MouseMove="MapViewport_MouseMove" MouseLeave="MapViewport_MouseLeave" SizeChanged="MapViewport_SizeChanged">
                            <Image x:Name="MapImage" Stretch="Fill" SnapsToDevicePixels="True" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="NearestNeighbor"><Image.RenderTransform><MatrixTransform x:Name="MapTransform"/></Image.RenderTransform></Image>
                            <TextBlock x:Name="EmptyMapText" Text="Load a configuration and render a READY source." HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#6E7781" FontSize="15" IsHitTestVisible="False"/>
                            <Border x:Name="ScaleBarPanel" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="14" Padding="7,5" Background="#DFFFFFFF" BorderBrush="#55000000" BorderThickness="1" CornerRadius="3" Visibility="Collapsed" IsHitTestVisible="False"><StackPanel><TextBlock x:Name="ScaleBarText" Text="-" FontSize="11" FontWeight="SemiBold" Foreground="#111111" HorizontalAlignment="Center" Margin="0,0,0,2"/><Border x:Name="ScaleBarLine" Width="100" Height="7" BorderBrush="#111111" BorderThickness="1,0,1,2"/></StackPanel></Border>
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="14" Padding="6,4" Background="#BFFFFFFF" CornerRadius="3" IsHitTestVisible="False"><TextBlock Text="Wheel: zoom  |  Drag: pan  |  Click: query ALL READY sources" Foreground="#57606A" FontSize="11"/></Border>
                        </Grid>
                    </Border>
                    <Grid Grid.Row="2" Margin="0,8"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CursorInfoText" Grid.Column="0" Text="Lat: -   Lon: -   Value: -"/><TextBlock x:Name="PointQueryText" Grid.Column="1" Margin="18,0,0,0" Foreground="#57606A"/></Grid>
                    <Border x:Name="PointResultsPanel" Grid.Row="3" BorderBrush="#D8DEE4" BorderThickness="1" CornerRadius="4" Visibility="Collapsed" Padding="6">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <TextBlock x:Name="PointResultsHeaderText" Grid.Row="0" FontWeight="SemiBold" Margin="4,2,4,6"/>
                            <DataGrid x:Name="PointResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="100"/><DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="*"/><DataGridTextColumn Header="Value" Binding="{Binding Value}" Width="115"/><DataGridTextColumn Header="Unit" Binding="{Binding Unit}" Width="60"/><DataGridTextColumn Header="Mode" Binding="{Binding Mode}" Width="95"/><DataGridTextColumn Header="Lat" Binding="{Binding Latitude}" Width="85"/><DataGridTextColumn Header="Lon" Binding="{Binding Longitude}" Width="85"/><DataGridTextColumn Header="Depth" Binding="{Binding Depth}" Width="65"/><DataGridTextColumn Header="Variable" Binding="{Binding Variable}" Width="110"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            <Border x:Name="DerivedResultsPanel" Grid.Row="2" Margin="0,8,0,0" Padding="6" BorderBrush="#B8C7D9" BorderThickness="1" CornerRadius="4" Background="#F8FAFC" Visibility="Collapsed">
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="125"/></Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="User-derived results (configured mapping table)" FontWeight="SemiBold" Margin="4,1,4,5"/>
                                    <DataGrid x:Name="DerivedResultsGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Mapping" Binding="{Binding Mapping}" Width="115"/>
                                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="110"/>
                                            <DataGridTextColumn Header="SHOM DB" Binding="{Binding ShomCode}" Width="85"/>
                                            <DataGridTextColumn Header="SHOM 원 분류" Binding="{Binding ShomOriginal}" Width="165"/>
                                            <DataGridTextColumn Header="1차 분류" Binding="{Binding Primary}" Width="115"/>
                                            <DataGridTextColumn Header="해저저질" Binding="{Binding Seabed}" Width="*"/>
                                            <DataGridTextColumn Header="매몰률" Binding="{Binding BurialRate}" Width="70"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <StatusBar Grid.Row="2" Margin="0,10,0,0"><StatusBarItem><TextBlock x:Name="StatusText" Text="Ready"/></StatusBarItem></StatusBar>
    </Grid>
</Window>
